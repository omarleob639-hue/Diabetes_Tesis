%Ejercicio------------------------------------------------------------------------------
\newcommand{\nuevoboiejercicio}[6]{ \newboxedtheorem[
boxcolor=#3,
 background=#4,
 titlebackground=#5,
 titleboxcolor = #6,
 size = \textwidth]{#1}{#2}{EjercicioCounter}}

 \definecolor{ejercolor1}{RGB}{167,172,147}        % borde general
 \definecolor{ejercolor2}{RGB}{240,241,231}     % fondo del cuerpo
 \definecolor{ejercolor3}{RGB}{138,172,147}        % fondo del encabezado
 \definecolor{ejercolor4}{RGB}{167,172,147}     % borde del encabezado
 %---------txt color
 \definecolor{itcrtxtcolor}{RGB}{255,255,255}

 %%%%%EJERCICIO
  \newboxedtheorem[
    boxcolor         = ejercolor1,
    background       = ejercolor2,
    titlebackground  = ejercolor3,
    titleboxcolor    = ejercolor4,
   size = \textwidth]{bejercicio}{\color{itcrtxtcolor}Ejercicio}{EjercicioCounter}%{thCounter}%{anything}	

 \newenvironment{bejerciciocont}{
 \addtocounter{EjercicioCounter}{-1} \begin{bejercicio}[\textbf{(Continuación).}]}{
    \end{bejercicio}}
