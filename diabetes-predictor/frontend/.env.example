# URL publica del backend FastAPI.
# Local:      http://localhost:8000
# Produccion: la URL de AWS Lambda o App Runner tras desplegar.
#
# Esta variable se INCRUSTA en el bundle al compilar. Si la cambias en Vercel
# despues del deploy, hay que volver a desplegar para que surta efecto.
VITE_API_BASE_URL=http://localhost:8000