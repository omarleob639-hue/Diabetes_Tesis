# Conexion a PostgreSQL (Supabase > Connection string > URI)
DATABASE_URL=postgresql://postgres.proyecto:clave@aws-0-region.pool.supabase.com:5432/postgres

# Origenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:5173

# Ruta al modelo entrenado, relativa a backend/
MODEL_PATH=model/saved_model

# Devuelve probabilidades ficticias para desarrollo de interfaz.
# Nunca debe quedar en true en un despliegue real.
MODEL_STUB_ENABLED=true