# Entornos virtuales
Tesis_env/
venv/
.venv/
env/
.env
.env.*
!.env.example

# Python & FastAPI
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
test.db

# Jupyter Notebook
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Machine Learning (TensorFlow, Scikit-learn)
*.h5
*.tflite
*.joblib
*.pkl
*.npy
*.npz

# JavaScript, React & Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Web & Deployment (React, Vercel, FastAPI)
build/
dist/
.next/
.vercel/
out/

# Database (PostgreSQL, Supabase)
# Las migraciones y seeds SI se versionan; solo se descartan los vuelcos de base de datos
*.dump
*.backup
supabase/.temp/

# AWS Lambda
.aws-sam/

# Google Antigravity & Assistant Tools
.gemini/
antigravity/
.claudecode/

# Grabaciones y multimedia de tesis
# GitHub rechaza de forma dura cualquier archivo mayor a 100 MB, y las
# grabaciones de las entrevistas pesan entre 150 y 530 MB cada una.
*.mp4
*.crswap
*.lol

# LaTeX (archivos temporales)
*.aux
*.log
*.toc
*.out
*.pdf
*.synctex.gz
*.bbl
*.blg
*.bcf
*.run.xml
*.maf
*.mtc*
*.lof
*.lot
*.loa
*.thm
*.fdb_latexmk
*.fls
# Data (Datasets clínicos)
diabetes-predictor/data/*.csv
diabetes-predictor/data/*.xlsx
diabetes-predictor/data/*.json
diabetes-predictor/data/raw/*
diabetes-predictor/data/processed/*
# Los .gitkeep sí se versionan para que GitHub muestre la estructura de carpetas
!diabetes-predictor/data/**/.gitkeep
